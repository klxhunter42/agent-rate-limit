      },
      "options": { "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Tokens Saved Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "expr": "sum(rate(api_gateway_optimizer_tokens_saved_total[$__rate_interval]))", "legendFormat": "tokens/sec", "refId": "A" }
