    {
      "title": "Chars Saved by Technique",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "sum by (technique) (rate(api_gateway_optimizer_chars_saved_total[$__rate_interval]))", "legendFormat": "{{technique}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "chars/sec",
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
