  "panels": [
    {
      "title": "Goroutines",
      "description": "Current number of Go goroutines in the gateway process. Sustained growth may indicate goroutine leaks.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "api_gateway_go_goroutines or on() vector(0)",
          "legendFormat": "goroutines",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "lineWidth": 2,
          "custom": {
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Memory",
      "description": "Go runtime memory usage. heap_alloc = bytes allocated on the heap. stack_inuse = bytes in use by stack spans. Unit: bytes.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "api_gateway_go_heap_alloc_bytes or on() vector(0)",
          "legendFormat": "heap_alloc",
          "refId": "A"
        },
        {
          "expr": "api_gateway_go_stack_inuse_bytes or on() vector(0)",
          "legendFormat": "stack_inuse",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "lineWidth": 2,
          "custom": {
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "GC Pause",
      "description": "Go garbage collector pause duration. Spikes correlate with STW pauses that can increase request latency. Unit: nanoseconds.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "api_gateway_go_gc_pause_ns or on() vector(0)",
          "legendFormat": "gc_pause",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "lineWidth": 2,
          "custom": {
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Heap Objects",
      "description": "Number of distinct objects allocated on the Go heap. Steady growth without GC reclaim indicates potential memory leak.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "api_gateway_go_heap_objects or on() vector(0)",
          "legendFormat": "heap_objects",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "lineWidth": 2,
          "custom": {
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Dragonfly Health",
      "description": "Dragonfly (Redis-compatible) connectivity status. 1 = healthy, 0 = down. Based on api_gateway_dragonfly_up gauge.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "api_gateway_dragonfly_up",
          "legendFormat": "Dragonfly",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Healthy",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "N/A",
                  "color": "gray"
                }
              }
            }
          ],
          "noValue": "N/A"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "title": "Waste Detection Findings",
      "description": "Rate of token waste findings per second, broken down by detector and severity. Based on api_gateway_waste_findings_total.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "(sum by (detector, severity) (increase(api_gateway_waste_findings_total[$__interval])))",
          "legendFormat": "{{detector}} ({{severity}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "lineWidth": 2
        },
        "overrides": []
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    }
  ],
  "schemaVersion": 39,
  "tags": [
