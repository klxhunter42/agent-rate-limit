    {
      "title": "Go Direct Success Rate",
      "description": "Percentage of requests routed directly to Claude without sidecar hop or rejection. Higher = better cost efficiency.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_billing_path_requests_total{path=\"go_direct\"}[$__range])) / (sum(increase(api_gateway_billing_path_requests_total{path=~\"go_direct|sidecar|billing_rejected\"}[$__range])) > 0) * 100) or on() vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        }
      },
      "options": {
        "sort": "desc",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
