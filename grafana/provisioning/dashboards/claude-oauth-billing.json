    {
      "title": "Billing Path Total (Last 1h)",
      "description": "Total request count per billing path in the selected time range. Go Direct = optimal path, Sidecar = extra hop, Rejected = blocked before upstream.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 15,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_billing_path_requests_total{path=\"go_direct\"}[$__range]))) or on() vector(0)",
          "legendFormat": "Go Direct",
          "refId": "A"
        },
        {
          "expr": "(sum(increase(api_gateway_billing_path_requests_total{path=\"sidecar\"}[$__range]))) or on() vector(0)",
          "legendFormat": "Sidecar",
          "refId": "B"
        },
        {
          "expr": "(sum(increase(api_gateway_billing_path_requests_total{path=\"billing_rejected\"}[$__range]))) or on() vector(0)",
          "legendFormat": "Rejected",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
