    {
      "title": "Go Direct Success Rate",
      "description": "Percentage of requests routed via go_direct vs all billing paths. go_direct / (go_direct + sidecar + rejected) * 100. Unit: percent.",
      "type": "gauge",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_billing_path_requests_total{path=\"go_direct\"}[$__range])) / (sum(increase(api_gateway_billing_path_requests_total{path=~\"go_direct|sidecar|billing_rejected\"}[$__range])) > 0) * 100) or on() vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        }
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "title": "Billing Path Latency",
      "description": "Latency percentiles (p50, p95, p99) per billing path from api_gateway_billing_path_latency_seconds histogram. Unit: seconds.",
