  "panels": [
    {
      "title": "Traffic & Latency",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "title": "Request Rate by Path",
      "description": "Requests per second broken down by path, method, and status code. Unit: req/s.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum by (path, method, status) (increase(api_gateway_request_latency_seconds_count[$__interval])))",
          "legendFormat": "{{method}} {{path}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "spanNulls": false,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "lineWidth": 2
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Latency Percentiles",
      "description": "P50, P95, and P99 request latency from histogram_quantile of api_gateway_request_latency_seconds. Unit: seconds.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "(histogram_quantile(0.50, sum by (le) (rate(api_gateway_request_latency_seconds_bucket[$__interval]))))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(api_gateway_request_latency_seconds_bucket[$__interval]))))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "(histogram_quantile(0.99, sum by (le) (rate(api_gateway_request_latency_seconds_bucket[$__interval]))))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "lineWidth": 2,
          "custom": {
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Avg Latency by Path",
      "description": "Average latency per path: rate(sum) / rate(count) of api_gateway_request_latency_seconds. Unit: seconds.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "(sum by (path) (rate(api_gateway_request_latency_seconds_sum[$__interval])) / sum by (path) (rate(api_gateway_request_latency_seconds_count[$__interval])))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "lineWidth": 2,
          "custom": {
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
