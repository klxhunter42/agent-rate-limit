    {
      "title": "In-Flight vs Limit per Model",
      "description": "Compares current in-flight requests (solid) against the adaptive concurrency limit (dashed) per model.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 47
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "lineWidth": 2
          },
          "unit": "short",
          "lineWidth": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "limit.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dot"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "sort": {
            "by": "name",
            "desc": true
          }
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "api_gateway_adaptive_in_flight or on() vector(0)",
          "legendFormat": "in-flight: {{model}}",
          "refId": "A"
        },
        {
          "expr": "api_gateway_adaptive_limit or on() vector(0)",
          "legendFormat": "limit: {{model}}",
          "refId": "B"
        }
      ],
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
