    {
      "title": "Request Rate by Path",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum by (path, method, status) (rate(api_gateway_request_latency_seconds_count[$__interval])))",
          "legendFormat": "{{method}} {{path}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "lineWidth": 2
        }
      },
      "showPoints": "never",
      "spanNulls": true,
      "lineWidth": 2
    },
    {
