    "api-gateway",
    "tokens",
    "monitoring"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Executive Overview",
      "url": "/d/arl-service-dashboard",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "Optimization",
      "url": "/d/arl-token-optimization",
      "type": "link",
      "icon": "bolt"
    },
    {
      "title": "Cost Calculator",
      "url": "/d/arl-cost",
      "type": "link",
      "icon": "calculator"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "description": "Key token usage metrics: total input/output units, request count, and estimated cost",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Total Input Units",
      "description": "Total input token units consumed across all models and profiles in the selected time range",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_token_input_total[$__range]))) or on() vector(0)",
          "legendFormat": "input",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000000
              },
              {
                "color": "red",
                "value": 10000000
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "sort": "desc"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Total Output Units",
      "description": "Total output token units generated across all models and profiles in the selected time range",
