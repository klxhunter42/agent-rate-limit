{
  "annotations": {
    "list": []
  },
  "description": "Token optimization pipeline performance and cost savings analysis",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Executive Overview",
      "url": "/d/arl-service-dashboard",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "Operations",
      "url": "/d/arl-gw-overview",
      "type": "link",
      "icon": "server"
    },
    {
      "title": "Privacy",
      "url": "/d/arl-pasteguard",
      "type": "link",
      "icon": "shield"
    }
  ],
  "panels": [
    {
      "title": "Optimization Summary",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "title": "Total Units Saved",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(api_gateway_optimizer_tokens_saved_total[$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "fixedColor": "#22c55e",
            "mode": "fixed"
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area",
            "justifyMode": "auto",
            "textMode": "auto",
            "wideLayout": true
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Cost Savings (USD)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(api_gateway_cost_savings_total[$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "USD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#15803d",
                "value": 1
              },
              {
                "color": "#166534",
                "value": 10
              }
            ]
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area",
            "justifyMode": "auto",
            "textMode": "auto",
            "wideLayout": true
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Optimization Runs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(api_gateway_optimizer_runs_total[$__range]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "fixedColor": "#3b82f6",
            "mode": "fixed"
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area",
            "justifyMode": "auto",
            "textMode": "auto",
            "wideLayout": true
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Optimization Efficiency",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 15,
        "y": 1
      },
      "targets": [
        {
          "expr": "clamp(sum(increase(api_gateway_optimizer_chars_saved_total{technique!=\"sketch_dedup\"}[$__range])) / 4 / (sum(increase(api_gateway_profile_token_input_total[$__range])) + sum(increase(api_gateway_optimizer_chars_saved_total{technique!=\"sketch_dedup\"}[$__range])) / 4) * 100, 0, 50)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 50,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "#a3e635",
                "value": 5
              },
              {
                "color": "#22c55e",
                "value": 10
              },
              {
                "color": "#16a34a",
                "value": 20
              },
              {
                "color": "#166534",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Avg Duration (ms)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(api_gateway_optimizer_duration_seconds_sum[$__rate_interval])) / sum(rate(api_gateway_optimizer_duration_seconds_count[$__rate_interval])) * 1000",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "color": {
            "fixedColor": "#8b5cf6",
            "mode": "fixed"
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area",
            "justifyMode": "auto",
            "textMode": "auto",
            "wideLayout": true
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Savings Over Time",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false
    },
    {
      "title": "Units Saved Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(rate(api_gateway_optimizer_tokens_saved_total[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "custom": {
            "fillOpacity": 30,
            "gradientMode": "scheme",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#22c55e",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Cost Savings Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
