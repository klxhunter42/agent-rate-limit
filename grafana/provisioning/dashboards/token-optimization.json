{
  "annotations": {
    "list": []
  },
  "description": "Token optimization pipeline performance and cost savings analysis",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Executive Overview",
      "url": "/d/arl-service-dashboard",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "Operations",
      "url": "/d/arl-gw-overview",
      "type": "link",
      "icon": "server"
    },
    {
      "title": "Privacy",
      "url": "/d/arl-pasteguard",
      "type": "link",
      "icon": "shield"
    }
  ],
  "panels": [
    {
      "title": "Optimization Summary",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "title": "Input Tokens Optimized",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(api_gateway_optimizer_chars_saved_total{direction=\"input\"}[$__range])) / 4 or on() vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "fixedColor": "#22c55e",
            "mode": "fixed"
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area",
            "justifyMode": "auto",
            "textMode": "auto",
            "wideLayout": true
          }
        },
        "overrides": []
      },
      "description": "Total input tokens saved by the optimizer pipeline (all techniques). Optimizer only operates on the input/request side."
    },
    {
      "title": "Output Tokens Optimized",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(api_gateway_optimizer_chars_saved_total{direction=\"output\"}[$__range])) / 4 or on() vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "fixedColor": "#6b7280",
            "mode": "fixed"
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "none",
            "justifyMode": "auto",
            "textMode": "auto",
            "wideLayout": true
          }
        },
        "overrides": []
      },
      "description": "Output tokens saved by response trimming. Shows 0 until response optimization is triggered by actual AI traffic."
    },
    {
      "title": "Cost Savings (USD)",
      "description": "Estimated USD saved. tokens_saved x blended_rate. blended_rate = cost_input / token_input (weighted avg $/token).",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_optimizer_chars_saved_total{direction=\"input\"}[$__range])) / 4 * sum(increase(api_gateway_cost_total{type=\"input\"}[$__range])) / (sum(increase(api_gateway_token_input_total[$__range])) + 1)) or on() vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "USD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#15803d",
                "value": 1
              },
              {
                "color": "#166534",
                "value": 10
              }
            ]
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area",
            "justifyMode": "auto",
            "textMode": "auto",
            "wideLayout": true
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Optimization Runs",
      "description": "Total optimizer pipeline invocations. Each API request triggers one run.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_optimizer_runs_total[$__range]))) or on() vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "fixedColor": "#3b82f6",
            "mode": "fixed"
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area",
            "justifyMode": "auto",
            "textMode": "auto",
            "wideLayout": true
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Optimization Efficiency",
      "description": "Savings percentage = tokens_saved / tokens_sent x 100. Higher = more input tokens reduced.",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_optimizer_chars_saved_total{direction=\"input\"}[$__range])) / 4 / (sum(increase(api_gateway_token_input_total[$__range])) + 1) * 100) or on() vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 50,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "#a3e635",
                "value": 5
              },
              {
                "color": "#22c55e",
                "value": 10
              },
              {
                "color": "#16a34a",
                "value": 20
              },
              {
                "color": "#166534",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Avg Duration (ms)",
      "description": "Average chunker reorder latency per optimization run.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(rate(api_gateway_chunker_reorder_duration_seconds_sum[$__rate_interval])) / sum(rate(api_gateway_chunker_reorder_duration_seconds_count[$__rate_interval])) * 1000) or on() vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "color": {
            "fixedColor": "#8b5cf6",
            "mode": "fixed"
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area",
            "justifyMode": "auto",
            "textMode": "auto",
            "wideLayout": true
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Savings Over Time",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false
    },
    {
      "title": "Tokens Saved Over Time",
      "description": "Token savings rate (tokens/sec) stacked by technique. sketch_dedup usually dominates.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (technique) (increase(api_gateway_optimizer_chars_saved_total{direction=\"input\"}[$__interval])) / 4",
          "legendFormat": "{{technique}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "custom": {
            "fillOpacity": 30,
            "gradientMode": "scheme",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            }
          },
          "lineWidth": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#22c55e",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Cost Savings Over Time",
      "description": "USD savings rate over time. tokens_saved x blended_rate in rate form.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "(sum(rate(api_gateway_optimizer_chars_saved_total{direction=\"input\"}[$__interval])) / 4 * sum(rate(api_gateway_cost_total{type=\"input\"}[$__interval])) / (sum(rate(api_gateway_token_input_total[$__interval])) + 1)) or on() vector(0)",
          "legendFormat": "savings ($/s)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "USD",
          "color": {
            "mode": "fixed"
          },
          "custom": {
            "fillOpacity": 30,
            "gradientMode": "scheme",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "lineWidth": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#22c55e",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Optimization by Technique",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false
    },
    {
      "title": "Tokens Saved by Technique",
      "description": "Cumulative tokens saved per technique over the selected range. Stacked timeseries. sketch_dedup usually dominates.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "expr": "sort_desc(topk(10, sum by (technique) (increase(api_gateway_optimizer_chars_saved_total{direction=\"input\"}[$__interval]))) / 4)",
          "legendFormat": "{{technique}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "lineWidth": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Token Savings Breakdown",
      "description": "Token savings per technique excluding sketch_dedup. Shows non-dominant techniques' relative contribution. Unit: tokens (chars/4). For run count see Runs by Technique.",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "targets": [
        {
          "expr": "(sum by (technique) (increase(api_gateway_optimizer_chars_saved_total{technique!=\"sketch_dedup\",direction=\"input\"}[$__range])) / 4) or on() vector(0)",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "groupWidth": 0.7,
        "barWidth": 0.6,
        "stacking": "none"
      }
    },
    {
      "title": "Runs by Technique",
      "description": "Optimization invocation rate per technique. Shows how often each technique is applied, not savings volume.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "targets": [
        {
          "expr": "(sum by (technique) (increase(api_gateway_optimizer_runs_total[$__interval]))) or on() vector(0)",
          "legendFormat": "{{technique}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "lineWidth": 2
        },
        "overrides": []
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Before vs After",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "collapsed": false
    },
    {
      "title": "Before vs After Optimization",
      "description": "With = actual billed tokens (after optimizer). Without = estimated original tokens (before optimizer). Difference = tokens saved.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(increase(api_gateway_token_input_total[$__range])) or on() vector(0)",
          "refId": "A",
          "legendFormat": "With Optimization"
        },
        {
          "expr": "(sum(increase(api_gateway_token_input_total[$__range])) + sum(increase(api_gateway_optimizer_chars_saved_total{direction=\"input\"}[$__range])) / 4) or on() vector(0)",
          "refId": "B",
          "legendFormat": "Without Optimization"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Without Optimization"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#f97316",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "With Optimization"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#22c55e",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "title": "Optimization Rate Over Time",
      "description": "Real-time savings percentage = tokens_saved / tokens_sent x 100 at each point.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(api_gateway_optimizer_chars_saved_total{direction=\"input\"}[$__interval])) / 4 / (sum(rate(api_gateway_token_input_total[$__interval])) + 1) * 100) or on() vector(0)",
          "legendFormat": "optimization rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "lineWidth": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#22c55e",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Optimizer Performance (P95)",
      "description": "P95 latency of the waste scan component. Measures optimization overhead per request.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(api_gateway_waste_scan_duration_seconds_bucket[$__interval])) by (le)) or on() vector(0)",
          "legendFormat": "waste_scan p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(api_gateway_waste_scan_duration_seconds_bucket[$__interval])) by (le)) or on() vector(0)",
          "legendFormat": "waste_scan p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "lineWidth": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Technique Detail Table",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "collapsed": false
    },
    {
      "title": "Technique Performance",
      "description": "Per-technique breakdown: tokens saved (chars/4) and run count. Excludes sketch_dedup.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "(sum by (technique) (increase(api_gateway_optimizer_chars_saved_total{technique!=\"sketch_dedup\",direction=\"input\"}[$__range])) / 4) or on() vector(0)",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "(sum by (technique) (increase(api_gateway_optimizer_runs_total[$__range]))) or on() vector(0)",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "expr": "(sum by (technique) (increase(api_gateway_optimizer_runs_total[$__range]))) or on() vector(0)",
          "refId": "C",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value #A": "Tokens Saved",
              "Value #B": "Runs",
              "Value #C": "Runs (total)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellHeight": "sm"
          }
        },
        "overrides": []
      },
      "options": {
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ]
        },
        "sortBy": [
          {
            "desc": true,
            "displayName": "Tokens Saved"
          }
        ]
      }
    },
    {
      "title": "Budget & Waste",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "collapsed": false
    },
    {
      "title": "Budget Level",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(api_gateway_budget_level) or on() vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "description": "Average budget level across models. 0=green, 1=yellow, 2=red. Shows 0 until AI requests flow through."
    },
    {
      "title": "Waste Detection",
      "description": "Rate of waste detection scans per second. Monitors waste detection component activity.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 6,
        "y": 42
      },
