      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(rate(api_gateway_cost_savings_total[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "USD",
          "color": {
            "mode": "fixed"
          },
          "custom": {
            "fillOpacity": 30,
            "gradientMode": "scheme",
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#22c55e",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Optimization by Technique",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false
    },
    {
      "title": "Chars Saved by Technique",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "expr": "sum by (technique) (rate(api_gateway_optimizer_chars_saved_total{technique!=\"sketch_dedup\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["sum"]
        }
      }
    },
    {
      "title": "Savings by Technique",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "targets": [
        {
          "expr": "sum by (technique) (increase(api_gateway_optimizer_chars_saved_total{technique!=\"sketch_dedup\"}[$__range]))",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "groupWidth": 0.7,
        "barWidth": 0.6,
        "stacking": "none"
      }
    },
    {
      "title": "Runs by Technique",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "targets": [
        {
          "expr": "sum by (technique) (rate(api_gateway_optimizer_runs_total[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Before vs After",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "collapsed": false
    },
    {
      "title": "Before vs After Optimization",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(increase(api_gateway_profile_token_input_total[$__range])) + sum(increase(api_gateway_optimizer_chars_saved_total{technique!=\"sketch_dedup\"}[$__range])) / 4",
          "refId": "A",
          "legendFormat": "Without Optimization"
        },
        {
          "expr": "sum(increase(api_gateway_profile_token_input_total[$__range]))",
          "refId": "B",
          "legendFormat": "With Optimization"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Without Optimization"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#f97316",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "With Optimization"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#22c55e",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "title": "Optimization Rate Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "expr": "clamp(sum(rate(api_gateway_optimizer_chars_saved_total{technique!=\"sketch_dedup\"}[$__rate_interval])) / 4 / (sum(rate(api_gateway_profile_token_input_total[$__rate_interval])) + sum(rate(api_gateway_optimizer_chars_saved_total{technique!=\"sketch_dedup\"}[$__rate_interval])) / 4) * 100, 0, 100)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#22c55e",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Optimizer Performance (P95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, technique) (rate(api_gateway_optimizer_duration_seconds_bucket[$__rate_interval])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"]
        }
      }
    },
    {
      "title": "Technique Detail Table",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "collapsed": false
    },
    {
      "title": "Technique Performance",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum by (technique) (increase(api_gateway_optimizer_chars_saved_total{technique!=\"sketch_dedup\"}[$__range]))",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (technique) (increase(api_gateway_optimizer_runs_total[$__range]))",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (technique) (increase(api_gateway_optimizer_duration_seconds_sum[$__range])) / sum by (technique) (increase(api_gateway_optimizer_duration_seconds_count[$__range]))",
          "refId": "C",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value #A": "Chars Saved",
              "Value #B": "Runs",
              "Value #C": "Avg Duration (s)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellHeight": "sm"
          }
        },
        "overrides": []
      },
      "options": {
        "footer": {
          "show": true,
          "reducer": ["sum"]
        },
        "sortBy": [
          {
            "desc": true,
            "displayName": "Chars Saved"
          }
        ]
      }
    },
    {
      "title": "Budget & Waste",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "collapsed": false
    },
    {
      "title": "Budget Level",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "expr": "avg(api_gateway_budget_level)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Waste Detection",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 6,
        "y": 42
      },
      "targets": [
        {
          "expr": "sum by (severity) (rate(api_gateway_waste_scan_duration_seconds_count[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Wasted Units by Detector",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 15,
        "y": 42
      },
      "targets": [
        {
          "expr": "sum by (detector) (rate(api_gateway_waste_scan_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "scans",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    }
  ],
