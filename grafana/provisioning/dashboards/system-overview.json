  "panels": [
    {
      "title": "System Architecture",
      "type": "text",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "## Multi-Agent AI Rate-Limited System\nClient -> API Gateway (Go) -> Rate Limiter (Java) -> Dragonfly (Redis) -> AI Worker (Python) -> AI Provider"
      }
    },
    {
      "title": "Dragonfly Health",
      "description": "Dragonfly (Redis-compatible) health status. 1 = healthy, 0 = down, null = N/A.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "expr": "api_gateway_dragonfly_up",
          "legendFormat": "Dragonfly",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Healthy",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "N/A",
                  "color": "gray"
                }
              }
            }
          ],
          "noValue": "N/A"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "title": "Connections",
      "description": "Current active connections to the API gateway from api_gateway_active_connections.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 3
      },
      "targets": [
        {
          "expr": "api_gateway_active_connections or on() vector(0)",
          "legendFormat": "Active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      }
    },
    {
      "title": "Queue Depth",
      "description": "Pending items in the gateway queue (api_gateway_queue_depth) and AI worker queue (ai_worker_queue_depth).",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 3
      },
      "targets": [
        {
          "expr": "api_gateway_queue_depth or on() vector(0)",
          "legendFormat": "Gateway",
          "refId": "A"
        },
        {
          "expr": "ai_worker_queue_depth",
          "legendFormat": "Worker",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        }
      }
    },
    {
      "title": "Workers",
      "description": "Number of active AI workers from ai_worker_active gauge.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 3
      },
      "targets": [
        {
          "expr": "ai_worker_active",
          "legendFormat": "Active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "title": "Rate Limit Hits",
      "description": "Total upstream 429 responses in the selected time range from api_gateway_upstream_429_total.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 3
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_upstream_429_total[$__range]))) or on() vector(0)",
          "legendFormat": "Gateway",
          "refId": "A"
        },
        {
          "expr": "(sum(increase(api_gateway_upstream_429_total[$__range]))) or on() vector(0)",
          "legendFormat": "Worker",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "orange",
            "mode": "fixed"
          }
        }
      }
    },
    {
      "title": "Error Rate",
      "description": "429 error rate as a fraction of total requests: rate(429s) / rate(total_requests). Unit: percent.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 3
      },
      "targets": [
        {
          "expr": "(sum(rate(api_gateway_upstream_429_total[$__rate_interval])) / sum(rate(api_gateway_request_latency_seconds_count[$__rate_interval]))) or on() vector(0)",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Request Rate",
      "description": "Aggregate request rate through the gateway from api_gateway_request_latency_seconds_count. Unit: req/s.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_request_latency_seconds_count[$__interval]))) or on() vector(0)",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "lineWidth": 2,
          "custom": {
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Job Rate",
      "description": "Processed job rate (gateway requests) and failed job rate (ai_worker_jobs_failed_total). Unit: ops/s.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "expr": "increase(api_gateway_request_latency_seconds_count[$__interval]) or on() vector(0)",
          "legendFormat": "Processed",
          "refId": "A"
        },
        {
          "expr": "increase(ai_worker_jobs_failed_total[$__interval])",
          "legendFormat": "Failed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "lineWidth": 2,
          "custom": {
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Latency p95",
      "description": "P95 gateway request latency from api_gateway_request_latency_seconds histogram. Unit: seconds.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(api_gateway_request_latency_seconds_bucket[$__interval]))))",
          "legendFormat": "gateway p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "lineWidth": 2,
          "custom": {
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "429s & Retries",
      "description": "Rate of upstream 429 responses and retry attempts per second. Unit: ops/s.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "expr": "increase(api_gateway_upstream_429_total[$__interval]) or on() vector(0)",
          "legendFormat": "429s/s",
          "refId": "A"
        },
        {
          "expr": "increase(api_gateway_upstream_retries_total[$__interval]) or on() vector(0)",
          "legendFormat": "Retries/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "lineWidth": 2,
          "custom": {
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    }
  ],
