    {
      "title": "Provider Latency (p50/p95/p99)",
      "description": "Upstream API call latency percentiles. High p99 = slow provider responses.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "expr": "(histogram_quantile(0.50, sum by (le, path) (rate(api_gateway_request_latency_seconds_bucket[$__interval]))))",
          "legendFormat": "{{path}} p50",
          "refId": "A"
        },
        {
          "expr": "(histogram_quantile(0.95, sum by (le, path) (rate(api_gateway_request_latency_seconds_bucket[$__interval]))))",
          "legendFormat": "{{path}} p95",
          "refId": "B"
        },
        {
          "expr": "(histogram_quantile(0.99, sum by (le, path) (rate(api_gateway_request_latency_seconds_bucket[$__interval]))))",
          "legendFormat": "{{path}} p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "-",
          "custom": {
            "spanNulls": true,
            "lineWidth": 2,
            "showPoints": "never",
