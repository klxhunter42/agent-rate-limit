{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Executive Overview",
      "url": "/d/arl-service-dashboard",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "System Overview",
      "url": "/d/arl-overview",
      "type": "link",
      "icon": "server"
    },
    {
      "title": "Operations",
      "url": "/d/arl-gw-overview",
      "type": "link",
      "icon": "cog"
    }
  ],
  "panels": [
    {
      "title": "Jobs Processed / Failed / Retried",
      "description": "Per-second rate of jobs processed (by provider), failed, and retried over time. Unit: operations/sec.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "increase(api_gateway_request_latency_seconds_count[$__interval]) or on() vector(0)",
          "legendFormat": "Processed/s ({{provider}})",
          "refId": "A"
        },
        {
          "expr": "increase(ai_worker_jobs_failed_total[$__interval])",
          "legendFormat": "Failed/s",
          "refId": "B"
        },
        {
          "expr": "increase(ai_worker_jobs_retried_total[$__interval])",
          "legendFormat": "Retried/s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "spanNulls": false,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "noValue": "0",
          "lineWidth": 2
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Total Jobs",
      "description": "Cumulative count of processed, failed, and retried jobs over the selected time range. Unit: count.",
      "type": "stat",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(api_gateway_request_latency_seconds_count[$__range])) or on() vector(0)",
          "legendFormat": "Processed",
          "refId": "A"
        },
        {
          "expr": "sum(increase(ai_worker_jobs_failed_total[$__range])) or on() vector(0)",
          "legendFormat": "Failed",
          "refId": "B"
        },
        {
          "expr": "sum(increase(ai_worker_jobs_retried_total[$__range])) or on() vector(0)",
          "legendFormat": "Retried",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Queue Depth Over Time",
      "description": "Number of jobs waiting in the AI worker queue. Yellow above 50, red above 200.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "ai_worker_queue_depth",
          "legendFormat": "Queue Depth",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "spanNulls": false,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          },
          "lineWidth": 2
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Active Workers",
      "description": "Current number of active AI worker processes. Red at 0 (no workers running). Unit: count.",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "expr": "ai_worker_active or on() vector(0)",
          "legendFormat": "Active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 50,
          "noValue": "0",
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "title": "Error Rate %",
      "description": "Percentage of failed jobs out of total processed. failed_rate / request_rate * 100, clamped to 100%.",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "expr": "clamp_max(rate(ai_worker_jobs_failed_total[$__rate_interval]) / (rate(api_gateway_request_latency_seconds_count[$__rate_interval]) > 0) * 100, 100) or on() vector(0)",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "0",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        }
      }
    },
    {
      "title": "Rate Limit Hits",
      "description": "Total HTTP 429 responses received from upstream providers over the selected time range. Unit: count.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 16,
        "y": 9
      },
      "targets": [
        {
          "expr": "sum(increase(api_gateway_upstream_429_total[$__range])) or on() vector(0)",
          "legendFormat": "Total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "fixedColor": "orange",
            "mode": "fixed"
          }
        }
      }
    },
    {
      "title": "Total Provider Errors",
      "description": "Cumulative count of jobs that failed at the provider level over the selected time range. Unit: count.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 9
      },
      "targets": [
        {
          "expr": "sum(increase(ai_worker_jobs_failed_total[$__range])) or on() vector(0)",
          "legendFormat": "Errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          }
        }
      }
    },
    {
      "title": "API Usage - Input by Model",
      "description": "Input token consumption rate broken down by model. Unit: tokens/sec.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "expr": "(sum by (model) (increase(api_gateway_token_input_total[$__interval])))",
          "legendFormat": "{{model}} input",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "noValue": "0",
          "custom": {
            "spanNulls": false,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "lineWidth": 2
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "API Usage - Output by Model",
      "description": "Output token generation rate broken down by model. Unit: tokens/sec.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "expr": "(sum by (model) (increase(api_gateway_token_output_total[$__interval])))",
          "legendFormat": "{{model}} output",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "noValue": "0",
          "custom": {
            "spanNulls": false,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "lineWidth": 2
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Provider Latency (p50/p95/p99)",
      "description": "Request latency percentiles (p50, p95, p99) computed from the request duration histogram, grouped by API path. Unit: seconds.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "expr": "(histogram_quantile(0.50, sum by (le, path) (rate(api_gateway_request_latency_seconds_bucket[$__interval]))))",
          "legendFormat": "{{path}} p50",
          "refId": "A"
        },
        {
          "expr": "(histogram_quantile(0.95, sum by (le, path) (rate(api_gateway_request_latency_seconds_bucket[$__interval]))))",
          "legendFormat": "{{path}} p95",
          "refId": "B"
        },
        {
          "expr": "(histogram_quantile(0.99, sum by (le, path) (rate(api_gateway_request_latency_seconds_bucket[$__interval]))))",
          "legendFormat": "{{path}} p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "-",
          "custom": {
            "spanNulls": false,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "lineWidth": 2
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Worker Process Memory (RSS)",
      "description": "Resident (RSS) and virtual memory usage of the AI worker process. Unit: bytes.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"ai-worker\"}",
          "legendFormat": "RSS",
          "refId": "A"
        },
        {
          "expr": "process_virtual_memory_bytes{job=\"ai-worker\"}",
          "legendFormat": "Virtual",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "-",
          "custom": {
            "spanNulls": false,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "lineWidth": 2
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Worker CPU Usage",
      "description": "CPU consumption rate of the AI worker process. Unit: cores (1.0 = 100% of one CPU core).",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"ai-worker\"}[$__interval])",
          "legendFormat": "CPU seconds/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "core",
          "noValue": "-",
          "custom": {
            "spanNulls": false,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "lineWidth": 2
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Provider Errors by Provider",
      "description": "Rate of provider failures and upstream 429 rate-limit responses, broken down by provider. Unit: operations/sec.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "expr": "increase(ai_worker_jobs_failed_total[$__interval])",
          "legendFormat": "{{provider}} errors/s",
          "refId": "A"
        },
        {
          "expr": "increase(api_gateway_upstream_429_total[$__interval]) or on() vector(0)",
          "legendFormat": "{{provider}} rate-limited/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "0",
          "custom": {
            "spanNulls": false,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "lineWidth": 2
        }
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Account Input Tokens",
      "description": "Input token consumption rate per account and model combination. Unit: tokens/sec.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "targets": [
        {
          "expr": "(sum by (account_id, model) (increase(api_gateway_account_token_input_total[$__interval])))",
          "legendFormat": "{{account_id}}/{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "lineWidth": 2
        },
        "overrides": []
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    },
    {
      "title": "Account Output Tokens",
      "description": "Output token generation rate per account and model combination. Unit: tokens/sec.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 49
      },
      "targets": [
        {
          "expr": "(sum by (account_id, model) (increase(api_gateway_account_token_output_total[$__interval])))",
          "legendFormat": "{{account_id}}/{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "lineWidth": 2
        },
        "overrides": []
      },
      "showPoints": "never",
      "spanNulls": false,
      "lineWidth": 2
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "agent-rate-limit",
    "worker"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "title": "AI Worker - Detailed",
  "uid": "arl-worker",
  "version": 3
}
