          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "fixedColor": "orange",
            "mode": "fixed"
          }
        }
      },
      "options": {
        "sort": "desc"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
