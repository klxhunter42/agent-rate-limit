  "panels": [
    {
      "title": "Jobs Processed / Failed / Retried",
      "description": "Job processing stats: successful completions, failures, and retry attempts",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(api_gateway_request_latency_seconds_count[$__interval]) or on() vector(0)",
          "legendFormat": "Processed/s ({{provider}})",
          "refId": "A"
        },
        {
          "expr": "rate(ai_worker_jobs_failed_total[$__interval])",
          "legendFormat": "Failed/s",
          "refId": "B"
        },
        {
          "expr": "rate(ai_worker_jobs_retried_total[$__interval])",
          "legendFormat": "Retried/s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true,
            "lineWidth": 2,
            "showPoints": "never",
            "drawStyle": "line"
          },
          "noValue": "0",
          "lineWidth": 2
        }
      },
      "showPoints": "never",
      "spanNulls": true,
      "lineWidth": 2,
      "options": {
        "legend": {
          "sort": "sum",
          "sortDesc": true
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "title": "Total Jobs",
      "description": "Total job count by status: processed, failed, retried",
      "type": "stat",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(api_gateway_request_latency_seconds_count[$__range])) or on() vector(0)",
          "legendFormat": "Processed",
          "refId": "A"
        },
        {
          "expr": "sum(increase(ai_worker_jobs_failed_total[$__range])) or on() vector(0)",
          "legendFormat": "Failed",
          "refId": "B"
        },
        {
          "expr": "sum(increase(ai_worker_jobs_retried_total[$__range])) or on() vector(0)",
          "legendFormat": "Retried",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "sort": "desc"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "title": "Queue Depth Over Time",
      "description": "Number of jobs waiting in the processing queue over time. Sustained high depth = worker bottleneck.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "ai_worker_queue_depth",
          "legendFormat": "Queue Depth",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 20,
            "spanNulls": true,
            "lineWidth": 2,
            "showPoints": "never",
            "drawStyle": "line"
          },
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          },
          "lineWidth": 2
        }
      },
      "showPoints": "never",
      "spanNulls": true,
      "lineWidth": 2,
      "options": {
        "legend": {
          "sort": "sum",
          "sortDesc": true
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "title": "Active Workers",
      "description": "Number of currently active worker goroutines processing jobs",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "expr": "ai_worker_active or on() vector(0)",
          "legendFormat": "Active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 50,
          "noValue": "0",
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "sort": "desc"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "title": "Error Rate %",
      "description": "Job failure rate as percentage of total jobs. Spikes indicate upstream or processing issues.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "expr": "clamp_max(rate(ai_worker_jobs_failed_total[$__rate_interval]) / (rate(api_gateway_request_latency_seconds_count[$__rate_interval]) > 0) * 100, 100) or on() vector(0)",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "0",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        }
      },
      "options": {
        "sort": "desc",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "title": "Rate Limit Hits",
      "description": "Number of rate limit hits encountered by workers when calling upstream APIs",
