    {
      "title": "Before vs After",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "collapsed": false
    },
    {
      "title": "Before vs After Optimization",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_cost_savings_total[$__range])) * 333333) or on() vector(0)",
          "refId": "A",
          "legendFormat": "Without Optimization"
        },
        {
          "expr": "(sum(increase(api_gateway_token_input_total[$__range]))) or on() vector(0)",
          "refId": "B",
          "legendFormat": "With Optimization"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Without Optimization"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#f97316",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "With Optimization"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#22c55e",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "title": "Optimization Rate Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(api_gateway_chunker_chars_saved_total[$__interval])) + sum(rate(api_gateway_delta_chars_saved_total[$__interval])) + sum(rate(api_gateway_disclosure_chars_saved_total[$__interval])) + sum(rate(api_gateway_sketch_chars_saved_total[$__interval]))) or on() vector(0)",
          "legendFormat": "chars saved/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "lineWidth": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#22c55e",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "showPoints": "never",
      "spanNulls": true,
      "lineWidth": 2
    },
    {
      "title": "Optimizer Performance (P95)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(api_gateway_chunker_reorder_duration_seconds_bucket[$__interval])) by (le)) or on() vector(0)",
          "legendFormat": "chunker p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(api_gateway_waste_scan_duration_seconds_bucket[$__interval])) by (le)) or on() vector(0)",
          "legendFormat": "waste_scan p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "lineWidth": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "showPoints": "never",
      "spanNulls": true,
      "lineWidth": 2
    },
    {
      "title": "Technique Detail Table",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "collapsed": false
    },
    {
      "title": "Technique Performance",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "(sum by (technique) (increase(api_gateway_optimizer_chars_saved_total{technique!=\"sketch_dedup\",direction=\"input\"}[$__range]))) or on() vector(0)",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "(sum by (technique) (increase(api_gateway_optimizer_runs_total[$__range]))) or on() vector(0)",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "expr": "(sum by (technique) (increase(api_gateway_optimizer_duration_seconds_sum[$__range])) / sum by (technique) (increase(api_gateway_optimizer_duration_seconds_count[$__range]))) or on() vector(0)",
          "refId": "C",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value #A": "Chars Saved",
              "Value #B": "Runs",
              "Value #C": "Avg Duration (s)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellHeight": "sm"
          }
        },
        "overrides": []
      },
      "options": {
        "footer": {
          "show": true,
          "reducer": [
