    },
    {
      "title": "Optimization by Technique",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false
    },
    {
      "title": "Chars Saved by Technique",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "expr": "sort_desc(topk(10, sum by (technique) (increase(api_gateway_chunker_chars_saved_total[$__range])) + sum by (technique) (increase(api_gateway_delta_chars_saved_total[$__range])) + sum by (technique) (increase(api_gateway_disclosure_chars_saved_total[$__range])) + sum by (technique) (increase(api_gateway_sketch_chars_saved_total[$__range]))))",
          "legendFormat": "{{technique}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "lineWidth": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      },
      "showPoints": "never",
      "spanNulls": true,
      "lineWidth": 2
    },
    {
      "title": "Savings by Technique",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "targets": [
        {
          "expr": "(sum by (technique) (increase(api_gateway_optimizer_chars_saved_total{technique!=\"sketch_dedup\",direction=\"input\"}[$__range]))) or on() vector(0)",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "groupWidth": 0.7,
        "barWidth": 0.6,
        "stacking": "none"
      }
    },
    {
      "title": "Runs by Technique",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "targets": [
        {
          "expr": "sum(increase(api_gateway_chunker_reorder_duration_seconds_count[$__range])) or on() vector(0)",
          "legendFormat": "chunker",
          "refId": "A"
        },
        {
          "expr": "sum(increase(api_gateway_delta_encodes_total[$__range])) or on() vector(0)",
          "legendFormat": "delta",
          "refId": "B"
        },
        {
          "expr": "sum(increase(api_gateway_sketch_checks_total[$__range])) or on() vector(0)",
          "legendFormat": "sketch",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
