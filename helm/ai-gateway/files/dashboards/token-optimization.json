{
  "annotations": {
    "list": []
  },
  "description": "Token optimization pipeline performance and cost savings analysis",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Executive Overview",
      "url": "/d/arl-service-dashboard",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "Operations",
      "url": "/d/arl-gw-overview",
      "type": "link",
      "icon": "server"
    },
    {
      "title": "Privacy",
      "url": "/d/arl-pasteguard",
      "type": "link",
      "icon": "shield"
    }
  ],
  "panels": [
    {
      "title": "Optimization Summary",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "title": "Input Tokens Optimized",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_chunker_chars_saved_total[$__range])) + sum(increase(api_gateway_delta_chars_saved_total[$__range])) + sum(increase(api_gateway_disclosure_chars_saved_total[$__range])) + sum(increase(api_gateway_sketch_chars_saved_total[$__range]))) / 4 or on() vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "fixedColor": "#22c55e",
            "mode": "fixed"
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area",
            "justifyMode": "auto",
            "textMode": "auto",
            "wideLayout": true
          }
        },
        "overrides": []
      },
      "description": "Total input tokens saved by the optimizer pipeline (all techniques). Optimizer only operates on the input/request side."
    },
    {
      "title": "Output Tokens Optimized",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(api_gateway_optimizer_tokens_saved_total{direction=\"output\"}[$__range]))) or on() vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "fixedColor": "#6b7280",
            "mode": "fixed"
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "none",
            "justifyMode": "auto",
            "textMode": "auto",
            "wideLayout": true
          }
        },
        "overrides": []
      },
      "description": "Output tokens saved by response trimming. Shows 0 until response optimization is triggered by actual AI traffic."
    },
    {
      "title": "Cost Savings (USD)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_cost_savings_total[$__range]))) or on() vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "USD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#15803d",
                "value": 1
              },
              {
                "color": "#166534",
                "value": 10
              }
            ]
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area",
            "justifyMode": "auto",
            "textMode": "auto",
            "wideLayout": true
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Optimization Runs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_optimizer_runs_total[$__range]))) or on() vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "fixedColor": "#3b82f6",
            "mode": "fixed"
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area",
            "justifyMode": "auto",
            "textMode": "auto",
            "wideLayout": true
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Optimization Efficiency",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_cost_savings_total[$__range])) * 100000 / (sum(increase(api_gateway_cost_total[$__range])) + 1)) or on() vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 50,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "#a3e635",
                "value": 5
              },
              {
                "color": "#22c55e",
                "value": 10
              },
              {
                "color": "#16a34a",
                "value": 20
              },
              {
                "color": "#166534",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Avg Duration (ms)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(rate(api_gateway_optimizer_duration_seconds_sum[$__rate_interval])) / sum(rate(api_gateway_optimizer_duration_seconds_count[$__rate_interval])) * 1000) or on() vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "color": {
            "fixedColor": "#8b5cf6",
            "mode": "fixed"
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area",
            "justifyMode": "auto",
            "textMode": "auto",
            "wideLayout": true
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Savings Over Time",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false
    },
    {
      "title": "Units Saved Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (technique) (rate(api_gateway_chunker_chars_saved_total[$__interval]))",
          "legendFormat": "chunker",
          "refId": "A"
        },
        {
          "expr": "sum by (technique) (rate(api_gateway_delta_chars_saved_total[$__interval]))",
          "legendFormat": "delta",
          "refId": "B"
        },
        {
          "expr": "sum by (technique) (rate(api_gateway_disclosure_chars_saved_total[$__interval]))",
          "legendFormat": "disclosure",
          "refId": "C"
        },
        {
          "expr": "sum by (technique) (rate(api_gateway_sketch_chars_saved_total[$__interval]))",
          "legendFormat": "sketch",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "custom": {
            "fillOpacity": 30,
            "gradientMode": "scheme",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            }
          },
          "lineWidth": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#22c55e",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "showPoints": "never",
      "spanNulls": true,
      "lineWidth": 2
    },
    {
      "title": "Cost Savings Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(rate(api_gateway_cost_savings_total[$__interval])) or on() vector(0)",
          "legendFormat": "savings ($/s)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "USD",
