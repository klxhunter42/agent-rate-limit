          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#22c55e",
                "value": null
              },
              {
                "color": "#eab308",
                "value": 10
              },
              {
                "color": "#f97316",
                "value": 50
              },
              {
                "color": "#ef4444",
                "value": 100
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "background_solid",
        "sort": "desc"
