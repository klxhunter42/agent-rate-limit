    {
      "type": "bargauge",
      "title": "Before vs After Optimization",
      "description": "Shows estimated API unit consumption before and after the optimization pipeline. The difference represents cost savings.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(api_gateway_token_input_total[$__range]))) or on() vector(0)",
          "legendFormat": "Without Optimization"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(api_gateway_token_input_total[$__range])) - sum(increase(api_gateway_optimizer_chars_saved_total{direction=\"input\"}[$__range])) / 4) or on() vector(0)",
          "legendFormat": "With Optimization"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Without Optimization"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#f97316",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "With Optimization"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#22c55e",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
