    {
      "type": "stat",
      "title": "API Calls",
      "description": "Total requests processed in the selected period",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_request_latency_seconds_count[$__range]))) or on() vector(0)",
          "legendFormat": "API Calls",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "fixedColor": "super-light-blue",
            "mode": "fixed"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3b82f6",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "background_solid",
        "sort": "desc"
      }
    },
    {
      "type": "stat",
      "title": "Total Cost",
      "description": "Estimated cost of API usage in the selected period",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
