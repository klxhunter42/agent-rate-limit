      "description": "Estimated savings from the optimization pipeline",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_optimizer_chars_saved_total{direction=\"input\"}[$__range])) / 4 * sum(increase(api_gateway_cost_total{type=\"input\"}[$__range])) / (sum(increase(api_gateway_token_input_total[$__range])) + 1)) or on() vector(0)",
          "legendFormat": "Saved",
