    {
      "title": "Mask Duration by Phase (P95)",
      "description": "Privacy filter processing time by phase",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "lineWidth": 2
          },
          "unit": "s",
          "lineWidth": 2
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "sort": "mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "(histogram_quantile(0.95, sum by (le, phase) (rate(api_gateway_mask_duration_seconds_bucket[$__interval]))))",
          "legendFormat": "{{phase}} p95",
          "refId": "A"
        }
      ],
      "showPoints": "never",
      "spanNulls": true,
      "lineWidth": 2
    },
    {
      "title": "Processing Health",
      "description": "P95 mask duration - Healthy < 0.5s, Warning < 1s, Slow > 1s",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(api_gateway_mask_duration_seconds_bucket[$__rate_interval]))) or vector(0))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.5,
                "result": {
                  "text": "Healthy",
                  "color": "green"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.5,
                "to": 1,
                "result": {
                  "text": "Warning",
                  "color": "yellow"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 2,
                "result": {
                  "text": "Slow",
                  "color": "red"
                }
              }
            }
          ]
        }
      },
      "options": {
        "sort": "desc",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "title": "Clean Requests",
      "description": "Requests with no sensitive data detected",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 24
