{
  "annotations": {
    "list": []
  },
  "description": "Privacy protection status, PII/secrets detection, and data compliance monitoring.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Executive Overview",
      "url": "/d/arl-service-dashboard",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "Optimization",
      "url": "/d/arl-token-optimization",
      "type": "link",
      "icon": "bolt"
    },
    {
      "title": "Operations",
      "url": "/d/arl-gw-overview",
      "type": "link",
      "icon": "server"
    }
  ],
  "panels": [
    {
      "title": "Protection Status",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "title": "Total Requests Protected",
      "type": "stat",
      "description": "All requests that passed through the privacy filter",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_mask_requests_total[$__range])) or vector(0)) or on() vector(0)",
          "legendFormat": "Total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#3b82f6",
            "mode": "fixed"
          },
          "decimals": 0,
          "thresholds": {
            "steps": [
              {
                "color": "#3b82f6",
                "value": null
              }
            ]
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area"
          }
        }
      },
      "options": {
        "sort": "desc"
      }
    },
    {
      "title": "Secrets Blocked",
      "type": "stat",
      "description": "API keys, tokens, passwords detected and masked",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_pii_detected_total[$__range])) or vector(0)) or on() vector(0)",
          "legendFormat": "Secrets",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#f97316",
            "mode": "fixed"
          },
          "decimals": 0,
          "thresholds": {
            "steps": [
              {
                "color": "#f97316",
                "value": null
              }
            ]
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area"
          }
        }
      },
      "options": {
        "sort": "desc"
      }
    },
    {
      "title": "PII Masked",
      "type": "stat",
      "description": "Personal information (email, phone, national ID) masked",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(sum(increase(api_gateway_pii_detected_total[$__range])) or vector(0)) or on() vector(0)",
          "legendFormat": "PII",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#a855f7",
            "mode": "fixed"
          },
          "decimals": 0,
          "thresholds": {
            "steps": [
              {
                "color": "#a855f7",
                "value": null
              }
            ]
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area"
          }
        }
      },
      "options": {
        "sort": "desc"
      }
    },
    {
      "title": "Protection Coverage",
      "type": "stat",
      "description": "% of requests where sensitive data was detected and protected",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(clamp((sum(increase(api_gateway_mask_requests_total{has_secrets=\"true\"}[$__range])) + sum(increase(api_gateway_mask_requests_total{has_pii=\"true\"}[$__range]))) / sum(increase(api_gateway_mask_requests_total[$__range])) * 100, 0, 100) or vector(100)) or on() vector(0)",
          "legendFormat": "Coverage",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "steps": [
              {
                "color": "#22c55e",
                "value": null
              },
              {
                "color": "#22c55e",
                "value": 50
              },
              {
                "color": "#15803d",
                "value": 80
              },
              {
                "color": "#166534",
                "value": 95
              }
            ]
          },
          "custom": {
            "colorMode": "background_solid",
            "graphMode": "area"
          }
        }
      },
      "options": {
        "sort": "desc"
      }
    },
    {
      "title": "Privacy Protection Over Time",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false
    },
    {
      "title": "Protection Activity",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 30,
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 2
          },
          "unit": "short",
          "lineWidth": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Total"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#3b82f6",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Secrets Found"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#f97316",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PII Found"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#a855f7",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ],
          "sort": "sum",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(api_gateway_mask_requests_total[$__interval]))) or on() vector(0)",
          "legendFormat": "Total",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(api_gateway_mask_requests_total{has_secrets=\"true\"}[$__interval]))) or on() vector(0)",
          "legendFormat": "Secrets Found",
          "refId": "B"
        },
        {
          "expr": "(sum(rate(api_gateway_mask_requests_total{has_pii=\"true\"}[$__interval]))) or on() vector(0)",
          "legendFormat": "PII Found",
          "refId": "C"
        }
      ],
      "showPoints": "never",
      "spanNulls": true,
      "lineWidth": 2
    },
