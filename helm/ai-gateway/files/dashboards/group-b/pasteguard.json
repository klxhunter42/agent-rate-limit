      "targets": [
        {
          "expr": "((sum(increase(api_gateway_mask_requests_total[$__range])) - sum(increase(api_gateway_mask_requests_total{has_secrets=\"true\"}[$__range])) - sum(increase(api_gateway_mask_requests_total{has_pii=\"true\"}[$__range]))) or vector(0)) or on() vector(0)",
          "legendFormat": "Clean",
          "refId": "A"
