# Caddy serves HTTP on port 9000.
{
	log default {
		output stderr
		format json
		level INFO
	}
}

:9000 {
	handle /ws {
		reverse_proxy arl-gateway:8080 {
			flush_interval -1
		}
	}
	handle /hmr {
		reverse_proxy arl-gateway:8080 {
			flush_interval -1
		}
	}
	handle /v1/* {
		reverse_proxy arl-gateway:8080 {
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy arl-gateway:8080
	}
	handle /api/* {
		reverse_proxy arl-gateway:8080 {
			flush_interval -1
		}
	}
	handle /metrics {
		reverse_proxy arl-gateway:8080
	}
	handle /callback {
		reverse_proxy arl-gateway:8080
	}
	@grafana path /grafana /grafana/*
	handle @grafana {
		reverse_proxy arl-grafana:3000
	}
	handle_path /rl/* {
		reverse_proxy arl-rl-dashboard:8080
	}
	@mitmweb path /mitmweb /mitmweb/*
	handle @mitmweb {
		reverse_proxy arl-mitmweb:8081
	}
	handle {
		reverse_proxy arl-gateway:8080
	}
}
